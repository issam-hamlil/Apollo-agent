# ─────────────────────────────────────────────────────────────────────────────
# Apollo Agent — Environment Configuration Template
# Copy this file to `.env` and fill in your actual values.
# The `.env` file is gitignored; this file IS committed.
# ─────────────────────────────────────────────────────────────────────────────

# API Keys for cloud LLM providers
# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Provider selection: groq | ollama
# Default is `groq` with automatic circuit-breaker fallback to `ollama` on 429 rate limit.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# ── Ollama / OpenAI-compatible self-hosted executor ──────────────────────────
# Base URL of the Ollama HTTP endpoint (including /v1 suffix):
#   Local dev:  http://localhost:11434/v1
#   OCI prod:   http://<PUBLIC_IP>:8080/v1   (or behind nginx auth proxy)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Auth token sent as X-Api-Key header (empty for local, real token behind nginx):
OLLAMA_API_KEY=

#   Large model: used for prompts >= OLLAMA_SMALL_THRESHOLD_CHARS
#   Pipeline-proven (recommended): qwen2.5-coder:14b-instruct-q4_K_M
OLLAMA_MODEL=qwen2.5-coder:14b-instruct-q4_K_M
#   Small model: used for prompts < OLLAMA_SMALL_THRESHOLD_CHARS (faster)
OLLAMA_MODEL_SMALL=qwen2.5-coder:7b-instruct-q4_K_M
#   Escalation model: used specifically when FixerAgent repairs a module failed >= 2x
OLLAMA_MODEL_ESCALATION=qwen2.5-coder:32b-instruct-q4_K_M
OLLAMA_SMALL_THRESHOLD_CHARS=5000

# Auth token for the Apollo MCP server itself (checked on every POST /mcp/execute request).
# Generate with: openssl rand -hex 32
# Leave blank to run with no auth (local dev only).
APOLLO_API_KEY=

# Execution settings
OLLAMA_WATCHDOG_TIMEOUT_SECONDS=700
MODULE_TIMEOUT_MS=800000
SANDBOX_DOCKER_ENABLED=false
MAX_RETRY_COUNT=10

